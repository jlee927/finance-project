* {
   margin: 0;
   padding: 0;
}

body {
   font-family: "Roboto", sans-serif;
}

.navbar--container {
   display: flex;
   position: fixed;
   justify-content: space-between;
   height: 4.5em;
   max-width: 100%;
   box-shadow: 0 0 5px rgba(0, 0, 0, 0.2);
   width: 100%;
   /* Ensure it spans the entire width */
   z-index: 1000;
   /* Ensures it stays above other content */
   background: white;
}



.left--container {
   display: flex;
   /* padding-left: 1em; */
   /* border: solid #353535 1px; */
   /* border-radius: 1.5em; */
   /* background-color: #3C6E71; */
   margin-left: 2em;
   padding: 0 1em 0 1em;
   margin: 0.5em 0 0.5em 0;
}

.logo {
   /* width: 13em;
   height: 3em;
   margin-top: 0.2em;
   object-fit: cover; */
   margin-top: 0.8em;
   height: auto;
   width: auto;
   max-height: 72px;
   max-width: 290px;

   line-height: 4.5em;
}

.title {
   text-decoration: none;
   color: white;
   /* color: rgb(97, 97, 97); */
   /* color: #284b63; */
   font-size: 1.8rem;
   font-weight: 400;
   margin-top: 0.5em;
   margin-left: 0.2em;
   /* padding: 0.3em 0 0 0.5em; */
   font-style: italic;
   /* font-family: "New Amsterdam"; */
   /* font-family: "Roboto Slab"; */

   letter-spacing: 1px;
}

.add--entry {
   text-decoration: none;
   color: #284b63;
   font-weight: 400;
   font-size: 1em;

   /* background-color: #284b63; */
   border: solid 1px #284b63;
   border-radius: 3em;
   height: inherit;
   padding: 0.5em 1em;
   margin: 1.2em 0 0 0;
}

.add--entry:hover {
   background-color: #284b63;
   color: white;
}

.profile--img {
   margin-top: 1.2em;
   margin: 1.2em 0 0 1em;
}

.right--container {
   display: flex;
   padding-right: 1em;
}

.profile--img {
   width: 2em;
   height: 2em;
   border-radius: 2em;
}

.account--containers {
   border: solid green 1px;
   display: flex;
   background-color: #284b63;
   padding: 0 1.5em;
   border-radius: 2em;
   font-size: 1rem;
   margin: 0.6em 2em 0.6em 0;
   border: solid #353535 2px;
   height: 2.5em;
}

.login--nav {
   text-decoration: none;
   color: white;
   font-weight: 400;
   border-radius: 3em;
   height: inherit;
   padding: 1em 0 0 0;
}

.signup--nav {
   text-decoration: none;
   color: white;
   font-weight: 400;
   margin-right: 1em;
   padding: 1em 0.8em 0 0;
   border-right: solid rgb(72, 69, 69) 2px;
}

.dropdown {
   position: relative;
   display: inline-block;
}

.dropdown--content {
   display: none;
   position: absolute;
   background-color: #f9f9f9;
   min-width: 160px;
   box-shadow: 0px 8px 16px 0px rgba(0, 0, 0, 0.2);
   z-index: 1;
}

.dropdown:hover .dropdown--content {
   display: block;
}

.desc {
   padding: 15px;
   text-align: center;
}

.navbar--container a {
   text-decoration: none;
}

a:hover {
   color: #d9d9d9;
}

img:hover {
   cursor: pointer;
}
